# Скопіюй цей файл у .env і заповни своїми значеннями.
# .env НЕ має потрапляти в Git.

# PostgreSQL
DATABASE_URL=postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/ventcompany
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# Локальний адміністратор.
# Краще залишити ADMIN_PASSWORD порожнім — тоді буде згенеровано випадковий пароль
# і збережено локально у data/.setup_credentials.json.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Адміністратор
